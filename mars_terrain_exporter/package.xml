<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mars_terrain_exporter</name>
  <version>0.1.0</version>
  <description>Mars HiRISE terrain generation tool producing MuJoCo hfield models for HANUMAN</description>
  <maintainer email="siddarth.dayasagar@gmail.com">sid</maintainer>
  <author email="dayasagar.s@northeastern.edu">sid</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-rasterio</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-tqdm</exec_depend>
  <exec_depend>python3-mujoco</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
