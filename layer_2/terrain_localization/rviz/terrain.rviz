Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 30; 30; 38
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Offset:                          # at the map origin = ground level at spawn (z=0)
        X: 0
        Y: 0
        Z: 0
      Color: 80; 80; 80
    # ---- Navigation (layer_3) ----
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /nav/global_costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Draw Behind: true
      Alpha: 0.7
    - Class: rviz_default_plugins/Path
      Name: Global path
      Enabled: true
      Topic: {Value: /nav/global_path, Reliability Policy: Reliable}
      Color: 0; 255; 0
      Line Style: Billboards
      Line Width: 0.12
    - Class: rviz_default_plugins/Path
      Name: MPPI rollout
      Enabled: true
      Topic: {Value: /nav/mppi_path, Reliability Policy: Reliable}
      Color: 255; 170; 0
      Line Style: Billboards
      Line Width: 0.08
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Topic: {Value: /goal_pose}
      Color: 255; 0; 255
    # ---- Terrain localization / state estimation (layer_2) ----
    - Class: rviz_default_plugins/PointCloud2
      Name: HiRISE DEM
      Enabled: true
      Topic:
        Value: /terrain/dem_cloud
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: Local elevation map
      Enabled: true
      Topic:
        Value: /terrain/local_cloud
        Reliability Policy: Best Effort
      Style: Boxes
      Size (m): 0.12
      Color Transformer: FlatColor
      Color: 0; 255; 200
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth
      Enabled: true
      Topic: {Value: /ground_truth/odom, Reliability Policy: Best Effort}
      Shape: Axes
      Keep: 2000
      Covariance: {Value: false}
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Odometry
      Name: EKF
      Enabled: true
      Topic: {Value: /odometry/filtered, Reliability Policy: Reliable}
      Shape: Arrow
      Keep: 2000
      Covariance: {Value: false}
      Color: 80; 130; 255
    - Class: rviz_default_plugins/Odometry
      Name: GTSAM SLAM
      Enabled: true
      Topic: {Value: /slam/odometry, Reliability Policy: Reliable}
      Shape: Arrow
      Keep: 2000
      Covariance: {Value: false}
      Color: 255; 60; 60
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Terrain fix
      Enabled: true
      Topic: {Value: /terrain_match/pose, Reliability Policy: Reliable}
      Color: 255; 255; 0
      Covariance:
        Value: true
        Position: {Alpha: 0.4, Scale: 1.0, Color: 255; 255; 0}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal           # 2D Goal Pose -> /goal_pose (plans a path)
      Topic: {Value: /goal_pose}
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point: {X: 8, Y: 0, Z: 0}
      Pitch: 0.8
      Yaw: 3.0
