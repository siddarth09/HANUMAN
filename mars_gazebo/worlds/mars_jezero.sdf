<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="mars_surface">

    <!-- Bullet Featherstone for humanoid articulated bodies -->
    <physics name="default_physics" type="bullet">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Earth gravity for policy testing, change to -3.72 for Mars -->
    <gravity>0 0 -9.81</gravity>

    <!-- Mars atmosphere scene -->
    <scene>
      <ambient>0.4 0.3 0.2 1</ambient>
      <background>0.85 0.55 0.3 1</background>
    </scene>

    <!-- Sun — Mars-like warm directional light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 0.9 0.6 1</diffuse>
      <specular>0.3 0.2 0.1 1</specular>
      <direction>-0.3 -0.3 -1</direction>
    </light>

    <!-- Ambient fill light -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.3 0.2 0.15 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.3 0.3 -1</direction>
    </light>

    <!-- Camera starting position: looking at terrain center -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>5 -15 15 0 0.4 1.57</pose>
        <clip>
          <near>0.1</near>
          <far>500</far>
        </clip>
      </camera>
    </gui>

    <!-- ══════════ Mars Terrain (HiRISE Jezero DTM) ══════════ -->
    <!-- OBJ mesh: 150x150m, vertices from (0,0) to (150,150)  -->
    <!-- Centered at origin with pose offset                     -->
    <!-- Elevation ~4-5m, robot spawns at z=7                    -->
    <model name="mars_terrain">
      <static>true</static>
      <pose>-75 -75 0 0 0 0</pose>
      <link name="terrain_link">
        <visual name="terrain_visual">
          <geometry>
            <mesh>
              <uri>model://mars_terrain/mars_terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.72 0.45 0.2 1</ambient>
            <diffuse>0.72 0.45 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="terrain_collision">
          <geometry>
            <mesh>
              <uri>model://mars_terrain/mars_terrain.obj</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ══════════ System Plugins ══════════ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

  </world>
</sdf>
